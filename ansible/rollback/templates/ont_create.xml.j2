<soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope">
  <soapenv:Body>
    <rpc message-id="{{ 2147483647 | random }}" nodename="{{ cms_network | e }}" username="{{ cms_username | e }}" sessionid="{{ cms_session | e }}">
      <edit-config>
        <target><running/></target>
        <config>
          <top>
            <object operation="create" get-config="true">
              <type>Ont</type>
              <id><ont>{{ snapshot_ont.ont_id }}</ont></id>
              <admin>{{ snapshot_ont.admin_state | default("enabled", true) | e }}</admin>
              <serno>{{ snapshot_ont.serial_number | cms_serno | e }}</serno>
              <subscr-id>{{ snapshot_ont.subscriber_id | default("", true) | e }}</subscr-id>
              <descr>{{ snapshot_ont.description | default("", true) | e }}</descr>
              <ontprof>
                <type>OntProf</type>
                <id><ontprof>{{ snapshot_ont.profile | e }}</ontprof></id>
              </ontprof>
            </object>
          </top>
        </config>
      </edit-config>
    </rpc>
  </soapenv:Body>
</soapenv:Envelope>
