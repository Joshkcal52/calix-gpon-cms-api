<soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope">
  <soapenv:Body>
    <rpc message-id="{{ 2147483647 | random }}" nodename="{{ cms_network | e }}" username="{{ cms_username | e }}" sessionid="{{ cms_session | e }}">
      <edit-config>
        <target><running/></target>
        <config>
          <top>
            <object operation="create" get-config="true">
              <type>EthSvc</type>
              <id>
                <ont>{{ snapshot_ont.ont_id }}</ont>
                <ontslot>{{ ont_slot }}</ontslot>
                <ontethany>{{ item.service.ont_port }}</ontethany>
                <ethsvc>{{ item.service.service_index }}</ethsvc>
              </id>
              <admin>{{ item.service.admin_state | default("enabled", true) | e }}</admin>
              <descr>{{ item.service.description | default("", true) | e }}</descr>
              <tag-action>
                <type>SvcTagAction</type>
                <id><svctagaction>{{ item.service.tag_action | default("", true) | e }}</svctagaction></id>
              </tag-action>
              <bw-prof>
                <type>BwProf</type>
                <id><bwprof>{{ item.service.bandwidth_profile | default("", true) | e }}</bwprof></id>
              </bw-prof>
              <out-tag>{{ item.service.vlan | default("none", true) }}</out-tag>
              <in-tag>{{ item.service.inner_vlan | default("none", true) }}</in-tag>
            </object>
          </top>
        </config>
      </edit-config>
    </rpc>
  </soapenv:Body>
</soapenv:Envelope>
